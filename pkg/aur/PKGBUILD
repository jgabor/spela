# Maintainer: Jonathan Gabor <jonathan@jgabor.se>
pkgname=spela-git
_pkgname=${pkgname%-git}
pkgver=0.5.1.r6.g087d1c4
pkgrel=1
pkgdesc="Linux gaming configuration tool for NVIDIA GPUs with DLSS/DLL management (git version)"
arch=('x86_64')
url="https://github.com/jgabor/spela"
license=('MIT')
depends=('glibc' 'libgcc' 'nvidia-utils')
makedepends=('cargo' 'git')
optdepends=(
    'polkit: GPU and CPU tuning around game launches'
    'libkscreen: KDE VRR switching around game launches'
)
provides=('spela')
conflicts=('spela')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    git describe --long --abbrev=7 --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "$srcdir/$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p "$_pkgname"
}

package() {
    cd "$srcdir/$_pkgname"
    # /usr/bin, because Steam runs launch options with PATH=/usr/bin:/bin and
    # the polkit policy names /usr/bin/spela.
    install -Dm755 "target/release/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
    install -Dm644 data/polkit/io.github.spela.policy "$pkgdir/usr/share/polkit-1/actions/io.github.spela.policy"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
